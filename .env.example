# TAIKRY AI MARKET INTELLIGENCE PRO — Environment Configuration Template
# Copy this file to .env and insert your real production secrets.

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ADMIN_API_KEY=

# Database & Cache
# Local development only: sqlite:///./taikry_market.db (cloud filesystems may be ephemeral)
# PostgreSQL: postgresql://taikry_user:taikry_password@localhost:5432/taikry_db
DATABASE_URL=sqlite:///./taikry_market.db
REDIS_URL=redis://localhost:6379/0

# Timezone
LOCAL_TIMEZONE=Asia/Phnom_Penh

# OANDA v20 market data (read-only): auto detects practice/live unless OANDA_ENV is explicit.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=auto

# AI Provider Settings ("auto", "groq", "openrouter", "gemini", "deepseek", "claude", "openai", "manus", "quant")
AI_PROVIDER=auto

# =====================================================================
# 100% FREE AI LLM PROVIDERS (Zero Credit Card Required)
# =====================================================================
# 1. Groq Cloud (Free DeepSeek-R1-70B, Llama-3.3-70B, Mixtral-8x7B @ 500+ tok/s)
#    Get Free Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# 2. OpenRouter (Access 100% Free Models like deepseek-r1:free, llama-3.3:free)
#    Get Free Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_free_openrouter_key_here

# 3. Google Gemini Free Tier (15 RPM / 1,500 RPD Free on Gemini 1.5/2.0 Flash)
#    Get Free Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_free_gemini_key_here

# =====================================================================
# OPTIONAL PRO / PAID FRONTIER LLM PROVIDERS
# =====================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=deepseek/deepseek-v4-pro-0813
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-3-7-sonnet
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
MANUS_API_KEY=your_manus_ai_api_key_here
MANUS_API_URL=https://api.manus.ai/v1

# =====================================================================
# ANYROUTER INFERENCE INTEGRATION (OpenAI-Compatible Gateway)
# Base URL: https://anyrouter.dev/api/v1
# Docs: https://docs.anyrouter.dev/api-reference/models
# =====================================================================
ANYROUTER_API_KEY=your_anyrouter_api_key_here
ANYROUTER_BASE_URL=https://anyrouter.dev/api/v1
ANYROUTER_TIMEOUT_SECONDS=30
ANYROUTER_MAX_RETRIES=2
ANYROUTER_SPEND_LIMIT_USD=10.0
ANYROUTER_CONCURRENCY_LIMIT=3

# Multi-Agent Role Model Assignments (Discovered via GET /api/v1/models)
ORCHESTRATOR_MODEL=
REASONING_MODEL=
FAST_MODEL=
CRITIC_MODEL=
FALLBACK_MODEL=

# =====================================================================
# FREELLMAPI OPEN-SOURCE FLEET GATEWAY
# Repo: https://github.com/tashfeenahmed/freellmapi
# Pools free keys (Groq, Gemini, OpenRouter, Cerebras, SambaNova, HuggingFace)
# Run locally: docker run -d -p 4000:4000 tashfeenahmed/freellmapi
# Run cloud 24/7 (No PC needed): Deploy Docker image to Render / Railway / VPS
# =====================================================================
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_DEFAULT_MODEL=deepseek-r1
FREELLMAPI_TIMEOUT_SECONDS=30

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Make.com Scenario Webhook Targets (Optional)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your_scenario_webhook_id_here
MAKE_CRITICAL_ALERT_WEBHOOK=https://hook.us2.make.com/your_scenario_webhook_id_here
MAKE_PAPER_TRADE_WEBHOOK=https://hook.us2.make.com/your_scenario_webhook_id_here

# Windows Exness MT5 Bridge Configuration
MT5_BRIDGE_TOKEN=
MT5_BRIDGE_ENABLED=true
MT5_BRIDGE_STALE_SECONDS=30
MAX_DAILY_XAUUSD_SIGNALS=4
DEFAULT_STRATEGY_VERSION=ZYROX-SMC-V2.1

# 24/7 Monitoring & Risk Controls
AUTO_START_MONITORING=true
MONITORING_INTERVAL_MINUTES=15
COOLDOWN_MINUTES=15
MIN_CONFIDENCE_THRESHOLD=80
INITIAL_PAPER_BALANCE=100000.0
RISK_PER_TRADE_PERCENT=0.5
MIN_RISK_REWARD_RATIO=2.0
MAX_DAILY_LOSS_PERCENT=2.5
MAX_SIMULTANEOUS_POSITIONS=3

# =====================================================================
# ZYROX AI SAAS PLATFORM CONFIGURATION (14-Day Free Trial & Subscriptions)
# =====================================================================
PUBLIC_APP_URL=https://taikry-ai-trading.onrender.com
TELEGRAM_BOT_USERNAME=ZyroxAiTradingBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Initial Super Admin Bootstrap (Created idempotently on startup if not present)
SAAS_ADMIN_EMAIL=admin@zyrox.ai
SAAS_ADMIN_PASSWORD=generate-a-long-random-admin-password

# Optional SMTP for email verification and password resets
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Docker Compose PostgreSQL password (use a long random value)
POSTGRES_PASSWORD=change_this_to_a_long_random_password

# ABA PayWay eCommerce Checkout — set secrets in your local .env or Render dashboard
PAYMENT_PROVIDER=aba_payway
ABA_PAYWAY_ENV=sandbox
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
# RSA Private Key — store PEM with literal \n escapes (not required for HMAC hash signing)
ABA_PAYWAY_RSA_PRIVATE_KEY=
ABA_PAYWAY_API_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_CHECKOUT_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
# Public HTTPS URL; ABA sends the signed JSON callback here and may require whitelisting.
ABA_PAYWAY_CALLBACK_URL=
# Browser success/cancel redirect (billing page resumes invoice verification).
ABA_PAYWAY_RETURN_URL=https://your-domain.example/dashboard/billing.html
PAYMENT_DEFAULT_CURRENCY=USD
VIP_TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USERNAME=
BAKONG_KHQR_ACCOUNT=
USDT_TRC20_WALLET=
