# TAIKRY AI MARKET INTELLIGENCE PRO — Environment Configuration Template
# Copy this file to .env and insert your real production secrets.

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ADMIN_API_KEY=taikry_admin_access_token_2026

# Database & Cache
# SQLite default: sqlite:///./taikry_market.db
# PostgreSQL: postgresql://taikry_user:taikry_password@localhost:5432/taikry_db
DATABASE_URL=sqlite:///./taikry_market.db
REDIS_URL=redis://localhost:6379/0

# Timezone
LOCAL_TIMEZONE=Asia/Phnom_Penh

# AI Provider Settings ("auto", "groq", "openrouter", "gemini", "deepseek", "claude", "openai", "manus", "quant")
AI_PROVIDER=auto

# =====================================================================
# 100% FREE AI LLM PROVIDERS (Zero Credit Card Required)
# =====================================================================
# 1. Groq Cloud (Free DeepSeek-R1-70B, Llama-3.3-70B, Mixtral-8x7B @ 500+ tok/s)
#    Get Free Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# 2. OpenRouter (Access 100% Free Models like deepseek-r1:free, llama-3.3:free)
#    Get Free Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_free_openrouter_key_here

# 3. Google Gemini Free Tier (15 RPM / 1,500 RPD Free on Gemini 1.5/2.0 Flash)
#    Get Free Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_free_gemini_key_here

# =====================================================================
# OPTIONAL PRO / PAID FRONTIER LLM PROVIDERS
# =====================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MANUS_API_KEY=your_manus_ai_api_key_here
MANUS_API_URL=https://api.manus.ai/v1

# =====================================================================
# ANYROUTER INFERENCE INTEGRATION (OpenAI-Compatible Gateway)
# Base URL: https://anyrouter.dev/api/v1
# Docs: https://docs.anyrouter.dev/api-reference/models
# =====================================================================
ANYROUTER_API_KEY=your_anyrouter_api_key_here
ANYROUTER_BASE_URL=https://anyrouter.dev/api/v1
ANYROUTER_TIMEOUT_SECONDS=30
ANYROUTER_MAX_RETRIES=2
ANYROUTER_SPEND_LIMIT_USD=10.0
ANYROUTER_CONCURRENCY_LIMIT=3

# Multi-Agent Role Model Assignments (Discovered via GET /api/v1/models)
ORCHESTRATOR_MODEL=
REASONING_MODEL=
FAST_MODEL=
CRITIC_MODEL=
FALLBACK_MODEL=

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1004341134868-1004341134868
TELEGRAM_ADMIN_IDS=123456789,987654321

# Make.com Scenario Webhook Targets (Optional)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your_scenario_webhook_id_here
MAKE_CRITICAL_ALERT_WEBHOOK=https://hook.us2.make.com/your_scenario_webhook_id_here
MAKE_PAPER_TRADE_WEBHOOK=https://hook.us2.make.com/your_scenario_webhook_id_here

# Windows Exness MT5 Bridge Configuration
MT5_BRIDGE_TOKEN=zyrox_mt5_bridge_secure_token_change_me
MT5_BRIDGE_ENABLED=true
MT5_BRIDGE_STALE_SECONDS=30
MAX_DAILY_XAUUSD_SIGNALS=4
DEFAULT_STRATEGY_VERSION=ZYROX-SMC-V2.1
REQUIRE_MT5_FOR_SIGNALS=false  # Set to true to strictly block signal creation whenever MT5 terminal is disconnected

# 24/7 Monitoring & Risk Controls
AUTO_START_MONITORING=true
MONITORING_INTERVAL_MINUTES=15
COOLDOWN_MINUTES=15
MIN_CONFIDENCE_THRESHOLD=70
INITIAL_PAPER_BALANCE=100000.0
RISK_PER_TRADE_PERCENT=0.5
MIN_RISK_REWARD_RATIO=2.0
MAX_DAILY_LOSS_PERCENT=2.5
MAX_SIMULTANEOUS_POSITIONS=3
