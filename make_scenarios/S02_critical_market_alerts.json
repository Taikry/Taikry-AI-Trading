{
  "name": "S02_CRITICAL_MARKET_ALERTS",
  "description": "Receives instant high-conviction trade setups from 24/7 Python monitoring engine, filters for approved setups, deduplicates, and dispatches immediate high-priority alerts to Telegram and Discord.",
  "modules": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "name": "Critical Alert Webhook",
      "parameters": {
        "hook_id": "YOUR_MAKE_WEBHOOK_ID",
        "url": "https://hook.us2.make.com/YOUR_MAKE_WEBHOOK_ID"
      }
    },
    {
      "id": 2,
      "module": "builtin:Filter",
      "name": "Filter: Setup Approved",
      "filter": {
        "condition": [
          {"field": "1.event", "operator": "equal", "value": "VALIDATED_SIGNAL"},
          {"field": "1.direction", "operator": "in", "value": ["BUY", "SELL"]}
        ]
      }
    },
    {
      "id": 3,
      "module": "tools:Deduplicator",
      "name": "Event Deduplication",
      "parameters": {
        "key": "{{1.symbol}}_{{1.direction}}_{{1.entry_price}}"
      }
    },
    {
      "id": 4,
      "module": "telegram:sendTextMessage",
      "name": "Send Immediate High-Priority Alert",
      "parameters": {
        "chat_id": "{{1.chat_id}}",
        "parse_mode": "HTML",
        "text": "🚨 <b>TAIKRY PRO — CRITICAL SIGNAL ALERT</b>\n\n🎯 <b>Action:</b> {{if(1.direction == 'BUY'; '🟢 BUY'; '🔴 SELL')}} {{1.symbol}}\n💵 <b>Entry:</b> <code>{{1.entry_price}}</code>\n🛑 <b>Stop Loss:</b> <code>{{1.stop_loss}}</code>\n🎯 <b>TP 1:</b> <code>{{1.take_profit_1}}</code>\n🚀 <b>TP 2:</b> <code>{{1.take_profit_2}}</code>\n⚖️ <b>Risk/Reward:</b> <b>{{1.risk_reward}}</b>\n\n{{1.report_english}}"
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendRequest",
      "name": "Acknowledge Delivery",
      "parameters": {
        "url": "https://YOUR_PUBLIC_API_HOST/api/v1/notifications/ack",
        "method": "POST",
        "headers": [{"name": "Content-Type", "value": "application/json"}, {"name": "X-TAIKRY-API-KEY", "value": ""}],
        "body": "{\"event_id\": \"alert_{{1.symbol}}_{{1.timestamp}}\", \"channel\": \"webhook\", \"status\": \"SUCCESS\"}"
      }
    }
  ]
}
